#!/bin/bash
set -e

PLIST="/Library/LaunchAgents/com.hexyan.dji4ghub.usbwatcher.plist"
LABEL="com.hexyan.dji4ghub.usbwatcher"

CONSOLE_USER=$(stat -f "%Su" /dev/console)

if [ -z "${CONSOLE_USER}" ] || [ "${CONSOLE_USER}" = "root" ] || [ "${CONSOLE_USER}" = "loginwindow" ]; then
    exit 0
fi

USER_UID=$(id -u "${CONSOLE_USER}")

/bin/launchctl bootout \
    "gui/${USER_UID}/${LABEL}" \
    2>/dev/null || true

/bin/launchctl bootstrap \
    "gui/${USER_UID}" \
    "${PLIST}" \
    2>/dev/null || true

/bin/launchctl kickstart -k \
    "gui/${USER_UID}/${LABEL}" \
    2>/dev/null || true

exit 0
